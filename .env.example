# Supabase (Project Settings → API). KHÔNG commit file .env.local
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server (tạo/khóa tài khoản, ghi log đăng nhập, import cửa hàng)
SUPABASE_SERVICE_ROLE_KEY=
# Tùy chọn: domain email nội bộ sinh từ MSNV (mặc định wcm-technical.local)
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=wcm-technical.local
